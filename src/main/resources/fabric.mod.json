{
  "schemaVersion": 1,
  "id": "many_flowers",
  "version": "${version}",
  "name": "ManyFlowers",
  "description": "Decorate your world with new, colorful Flowers!",
  "authors": [
    "GalievDev before _VaLiOn_"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/many-flowers"
  },
  "license": "MIT",
  "icon": "assets/many_flowers/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.valion.manyflowers.client.ManyFlowersClient"
    ],
    "main": [
      "net.valion.manyflowers.ManyFlowers"
    ],
    "fabric-datagen": [
      "net.valion.manyflowers.ManyFlowersDataGen"
    ]
  },
  "custom": {
    "duckyupdater": {
      "modrinthId": "QUH6A4xu",
      "type": "release",
      "featured": false
    }
  },
  "mixins": [
    "ManyFlowers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "fabric-api": ">=${fabric_api}",
    "minecraft": ">=${minecraft_version}",
    "fabric-language-kotlin": ">=${kotlin_fabric}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "fstats": ">=${fstats_version}",
    "ducky-updater-lib": ">=${ducky_updater_version}"
  }
}
